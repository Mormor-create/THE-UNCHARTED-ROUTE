.env
.env.*
!.env.example
# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class

*.so

.Python

build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/

pip-wheel-metadata/
share/python-wheels/

*.egg-info/
.installed.cfg
*.egg
MANIFEST
